{
  "name": "qore-pq-health",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A Vite + React + wagmi dApp for the QoreChain EVM, with RainbowKit and the QoreX wallet.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/health.test.ts",
    "test:live": "node scripts/live-testnet-scan.mts",
    "test:e2e": "node scripts/repair-e2e-devnet.mts"
  },
  "dependencies": {
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qorex-rainbowkit": "^0.1.0",
    "@rainbow-me/rainbowkit": "^2.2.11",
    "@tanstack/react-query": "^5.59.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "viem": "~2.53.1",
    "wagmi": "^2.19.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.0"
  }
}
