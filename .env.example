# Network selection: "testnet" (default) or "devnet" (local node).
VITE_NETWORK=testnet

# Devnet overrides (only used with VITE_NETWORK=devnet).
# Defaults: /lcd-devnet and /evm-devnet (Vite proxies to localhost:1317/8545).
# VITE_DEVNET_REST=
# VITE_DEVNET_EVM_RPC=

# Testnet EVM RPC override (default: https://evm-testnet.qore.host).
# VITE_TESTNET_EVM_RPC=

# Only needed if you add a WalletConnect-based wallet to src/wagmi.ts.
# QoreX and injected browser wallets do not use it.
VITE_WALLETCONNECT_PROJECT_ID=
